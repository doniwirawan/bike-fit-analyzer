    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/index.test.js"
  },
  "keywords": [
    "bike-fit",
    "bikefit",
    "cycling",
    "pose-estimation",
    "mediapipe",
    "blazepose",
    "joint-angles",
    "biomechanics",
    "saddle-height",
    "knee-angle"
  ],
